FROM node:22-bookworm-slim AS web-build
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json frontend/.npmrc ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM maven:3.9-eclipse-temurin-21 AS api-build
WORKDIR /build
COPY backend/pom.xml ./
COPY backend/src/ ./src/
RUN mvn -B package

FROM eclipse-temurin:21-jre AS api
WORKDIR /app
COPY --from=api-build /build/target/gooci-console-*.jar ./console.jar
USER 10001:10001
ENTRYPOINT ["java", "-jar", "/app/console.jar"]

FROM nginxinc/nginx-unprivileged:stable-alpine AS web
COPY infra/delivery.nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=web-build /build/dist/ /usr/share/nginx/html/
