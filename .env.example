# 复制为 .env 或在进程环境注入。不要把填好的 .env 提交进仓库。

# 网关对外（域名 A 记录只指这一条公网 IP）
GOOCI_PUBLIC_DOMAIN=goocidata.top
GOOCI_PUBLIC_IP=154.201.65.68
GOOCI_PUBLIC_ORIGIN=https://goocidata.top
GOOCI_CORS_ORIGINS=https://goocidata.top,https://www.goocidata.top,http://goocidata.top,http://www.goocidata.top,http://154.201.65.68
GOOCI_SERVER_PORT=8080

# 库（客户 VPC 内网主机，不要填公网 IP）
GOOCI_DB_HOST=
GOOCI_DB_PORT=3306
GOOCI_DB_NAME=gooci
GOOCI_DB_USER=
GOOCI_DB_PASSWORD=
GOOCI_DB_SSL=false

GOOCI_JWT_SECRET=
GOOCI_JWT_EXPIRE_HOURS=12
GOOCI_SERVICE_PHONE=

# 模块和 AI 中台下一跳。其它模块生产必须是允许名单内的公网 https。
# 现在控制台和 deepseek-harness 在同一台云上。启动时把 AI 中台下一跳写成 http://127.0.0.1:3080。
# 云上启动 harness：dsh web --host 127.0.0.1 --port 3080 --no-open --trusted-host <AI公网IP[:端口]>
# GOOCI_AI_HUB_PUBLIC_URL 使用 https://<AI公网IP>:<公网TLS端口>/?token=...；nginx 在公网 TLS 端口整站反代到 127.0.0.1:3080。
# HTTPS 证书必须包含该公网 IP 的 IP SAN；不使用域名，也不能填 /ext/AI_HUB 子路径。
# 以后 harness 挪到另一台云，GOOCI_AI_HUB_LOCAL_FORWARD 改为 false。
GOOCI_EXT_ALLOW_HOSTS=
GOOCI_EXT_PDM_URL=
GOOCI_EXT_PACK_URL=
GOOCI_AI_HUB_LOCAL_FORWARD=true
GOOCI_AI_HUB_URL=
# GOOCI_AI_HUB_TOKEN=
# AI 中台公网入口：直接用公网 IP，不要填域名；nginx 整站反代到 127.0.0.1:3080。
# URL 格式：https://<AI公网IP>:<公网TLS端口>/?token=...，TLS 证书需含 IP SAN；不要填 /ext/AI_HUB 子路径。
GOOCI_AI_HUB_PUBLIC_URL=

# 仅当本机还要用 Vite 反代时填写网关 origin；生产静态资源同域，留空。
GOOCI_API_ORIGIN=
GOOCI_BIND_HOST=0.0.0.0
GOOCI_DEV_PORT=5173
