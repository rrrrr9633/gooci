# 复制为 .env 或在进程环境注入。不要把填好的 .env 提交进仓库。

# 网关对外（域名 A 记录只指这一条公网 IP）
GOOCI_PUBLIC_DOMAIN=goocidata.top
GOOCI_PUBLIC_IP=154.201.65.68
GOOCI_PUBLIC_ORIGIN=https://goocidata.top
GOOCI_CORS_ORIGINS=https://goocidata.top,https://www.goocidata.top,http://goocidata.top,http://www.goocidata.top,http://154.201.65.68
GOOCI_SERVER_PORT=8080

# 库（客户 VPC 内网主机，不要填公网 IP）
GOOCI_DB_HOST=
GOOCI_DB_PORT=3306
GOOCI_DB_NAME=gooci
GOOCI_DB_USER=
GOOCI_DB_PASSWORD=
GOOCI_DB_SSL=false

GOOCI_JWT_SECRET=
GOOCI_JWT_EXPIRE_HOURS=12
GOOCI_SERVICE_PHONE=

# 模块机 TARGET_URL：客户 VPC 私网。浏览器永不直连这些地址。
GOOCI_EXT_DEMO_URL=
GOOCI_EXT_PDM_URL=
GOOCI_EXT_PACK_URL=

# 仅当本机还要用 Vite 反代时填写网关 origin；生产静态资源同域，留空。
GOOCI_API_ORIGIN=
GOOCI_BIND_HOST=0.0.0.0
GOOCI_DEV_PORT=5173
